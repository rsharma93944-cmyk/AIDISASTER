# ResQAI Environment Configuration
# Copy this file to .env and fill in your values.

# Backend API URL — your deployed FastAPI server for YOLO11 landslide detection
# For local development: http://localhost:8000
# For production: set to your deployed backend URL in Netlify environment variables
VITE_API_BASE_URL=http://localhost:8000

# Google Maps JavaScript API Key (optional)
# Used for the homepage NER Risk Overview map section.
# The LiveMap page uses Leaflet + OpenStreetMap and does NOT require this key.
# Leave empty if you don't have a Google Maps API key.
VITE_GOOGLE_MAPS_API_KEY=
